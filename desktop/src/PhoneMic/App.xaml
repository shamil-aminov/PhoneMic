<Application x:Class="PhoneMic.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Fluent theme accent, so sliders and checkboxes match the app instead of the system colour. -->
        <Color x:Key="SystemAccentColor">#3DDC97</Color>
        <Color x:Key="SystemAccentColorLight1">#5FE3AA</Color>
        <Color x:Key="SystemAccentColorLight2">#83EAC0</Color>
        <Color x:Key="SystemAccentColorLight3">#A8F1D4</Color>
        <Color x:Key="SystemAccentColorDark1">#2FB27A</Color>
        <Color x:Key="SystemAccentColorDark2">#23895E</Color>
        <Color x:Key="SystemAccentColorDark3">#186043</Color>
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#3DDC97" />
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#5FE3AA" />
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#2FB27A" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#3DDC97" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#5FE3AA" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#2FB27A" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#3DDC97" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#5FE3AA" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#2FB27A" />
        <SolidColorBrush x:Key="Bg" Color="#0E1113" />
        <SolidColorBrush x:Key="Surface" Color="#171B1E" />
        <SolidColorBrush x:Key="SurfaceHigh" Color="#20262A" />
        <SolidColorBrush x:Key="Outline" Color="#2C3438" />
        <SolidColorBrush x:Key="Text" Color="#E8ECEE" />
        <SolidColorBrush x:Key="TextDim" Color="#8A969C" />
        <SolidColorBrush x:Key="Live" Color="#3DDC97" />
        <SolidColorBrush x:Key="LiveDim" Color="#1C4A38" />
        <SolidColorBrush x:Key="Warn" Color="#F2B84B" />
        <SolidColorBrush x:Key="Error" Color="#FF6B6B" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Live}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="12" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="{StaticResource SurfaceHigh}" BorderBrush="{StaticResource Outline}"
                                BorderThickness="1" CornerRadius="8" Padding="6,7" Margin="2,0">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource LiveDim}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Live}" />
                                <Setter Property="Foreground" Value="{StaticResource Live}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextDim}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
